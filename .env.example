# Postgres. Leave DATABASE_URL unset to run on an embedded PGlite database in ./.pgdata
# (fine for local development; use a real Postgres in production).
DATABASE_URL=

# Travelpayouts. Leave unset to run against the mock provider, which generates
# plausible prices with no network calls and no account.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# SerpApi. Leave unset and nothing is ever bought: off-property hotel rates
# stay as the hand-maintained estimate in config.ts, and flights fall back to
# BTS/Travelpayouts. This one key covers two metered jobs — Google Hotels
# (providers/serpapi.ts) and Google Flights (providers/serpapiFlights.ts).
SERPAPI_KEY=
SERPAPI_MAX_PER_HOUR=180

# --- The two jobs that cost money per lookup -------------------------------
# Hard ceiling on paid flight lookups in ONE run, enforced inside the
# provider. Every paid job fails closed: no key, no spend.
SERPAPI_FLIGHTS_BUDGET=200

# npm run popular-routes (nightly): buys real fares for the busiest searched
# routes. Worst case = LIMIT x DATES lookups a night (default 12 x 3 = 36).
POPULAR_ROUTES_LIMIT=12
POPULAR_ROUTES_DATES=3

# npm run intl-sweep (monthly): the only way international routes get priced
# at all — BTS DB1B is US-domestic only, so Paris/Tokyo/Shanghai/Hong Kong
# have no free baseline to fall back on. Cost is
#   19 origins x 5 intl airports x MONTHS x DATES
# = 1,140 lookups/month at the defaults. Raising DATES multiplies it directly.
INTL_SWEEP_MONTHS=12
INTL_SWEEP_DATES=1
# Shards the run one airport per job (the workflow sets this per matrix leg).
# Only ever narrows to the app's own international list; it cannot widen it.
INTL_SWEEP_DESTINATIONS=
# Minimum real fares on a route/quarter before a baseline is built from them.
INTL_BASELINE_MIN_SAMPLES=3

# Which flight_prices sources the trend multiplier is allowed to measure.
# Travelpayouts rows are excluded deliberately — see providers/travelpayouts.ts.
FARE_TREND_SOURCES=serpapi_flights

# Resend. Leave unset to print alert emails to the console instead of sending
# them — no account needed. ALERT_FROM_EMAIL needs a domain verified in Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@parkfare.app

PORT=8080

# Refresh job safety rails
MAX_REQUESTS_PER_MINUTE=240      # provider limit is 300; leave headroom
ALERT_MAX_PER_USER_PER_DAY=3
ALERT_ANOMALY_SHARE=0.4          # if >40% of rows move more than the threshold, assume bad data
ALERT_ANOMALY_MOVE_PCT=25
ALERT_GAS_MOVE_PCT=8             # gas price move since a driving trip was saved that's worth a Plus alert

# EIA (U.S. Energy Information Administration). Leave unset to use plausible mock
# national gas prices, no account needed. Free key: https://www.eia.gov/opendata/
EIA_API_KEY=

# News digest (src/jobs/newsDigest.ts) — a private, owner-only email, never shown
# to end users. Leave unset and the job still runs (tracking what it's seen) but
# doesn't send anything.
OWNER_EMAIL=

# Driving-mode "Departing from" city search (src/geo/). Nominatim + ip-api are both
# free and keyless — no key to set here — but default to mock anyway, same "no live
# calls unless deliberately turned on" rule as every other provider. Set to "true"
# to geocode/IP-locate for real.
GEOCODE_LIVE=
