# Postgres. Leave DATABASE_URL unset to run on an embedded PGlite database in ./.pgdata
# (fine for local development; use a real Postgres in production).
DATABASE_URL=

# Travelpayouts. Leave unset to run against the mock provider, which generates
# plausible prices with no network calls and no account.
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Resend. Leave unset to print alert emails to the console instead of sending
# them — no account needed. ALERT_FROM_EMAIL needs a domain verified in Resend.
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@parkfare.app

PORT=8080

# Refresh job safety rails
MAX_REQUESTS_PER_MINUTE=240      # provider limit is 300; leave headroom
ALERT_MAX_PER_USER_PER_DAY=3
ALERT_ANOMALY_SHARE=0.4          # if >40% of rows move more than the threshold, assume bad data
ALERT_ANOMALY_MOVE_PCT=25
